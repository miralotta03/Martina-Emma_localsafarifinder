// Cloudflare Worker för Local Safari Finder, byggd med @opennextjs/cloudflare.
// Inga hemligheter här: körtidsvariabler läggs i Cloudflares dashboard
// (Settings → Variables and Secrets), lokalt i .env.local. Se .env.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-safari-finder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image optimeras via Cloudflare Images. Gratisplanen: 5 000 unika
  // transformationer per månad, debiteras aldrig (över gränsen ger nya
  // transformationer fel 9422 i stället).
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Inte hemligt (syns i sidans HTML). Se .env.example.
  "vars": {
    "NEXT_PUBLIC_UMAMI_WEBSITE_ID": "b2fa7436-9eea-4de3-839d-9d0ab857be9b"
  }
}
