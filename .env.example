# Miljövariabler för Local Safari Finder. Inga riktiga värden i git.
#
# Var värdena läggs:
# - Lokalt (npm run dev och npm run preview): kopiera till .env.local.
# - Cloudflare, körtid (hemligheter, mejladresser): dashboarden →
#   Workers & Pages → local-safari-finder → Settings → Variables and Secrets.
#   API-nycklar läggs som "Secret".
# - Cloudflare, byggtid (allt som börjar med NEXT_PUBLIC_, bakas in i bygget):
#   Settings → Build → Variables and secrets.
# `npm run deploy` behåller dashboardens variabler (--keep-vars).

# Mottagaradress per företag för kontaktförfrågningar (lib/inquiry/recipients.ts).
# TODO: PLATSHÅLLARE. Ska fyllas i av kunden innan mejlutskick kopplas på.
# Cloudflare: körtid.
INQUIRY_TO_HEC_KILIMANJARO_SAFARIS=
INQUIRY_TO_SMART_ESCAPES=

# Mottagaradress för kontaktformuläret på /kontakta-oss (lib/contact/deliver.ts).
# TODO: PLATSHÅLLARE. Ska fyllas i av kunden innan mejlutskick kopplas på.
# Cloudflare: körtid.
CONTACT_TO=

# Kommande, används inte i koden än:
# API-nyckel för mejlutskick via Resend. Cloudflare: körtid, som Secret.
# RESEND_API_KEY=
# Länk till den externa partnerportalen (/for-foretag). Cloudflare: byggtid.
# NEXT_PUBLIC_PARTNER_PORTAL_URL=
