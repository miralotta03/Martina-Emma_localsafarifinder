# Miljövariabler för Local Safari Finder. Inga riktiga värden i git.
#
# Var värdena läggs:
# - Lokalt (npm run dev och npm run preview): kopiera till .env.local.
# - Cloudflare, körtid (hemligheter, mejladresser): dashboarden →
#   Workers & Pages → local-safari-finder → Settings → Variables and Secrets.
#   API-nycklar läggs som "Secret".
# - Cloudflare, byggtid (allt som börjar med NEXT_PUBLIC_, bakas in i bygget):
#   Settings → Build → Variables and secrets.
# `npm run deploy` behåller dashboardens variabler (--keep-vars).

# Resend, mejlen från kontaktformulären (lib/email.ts). Server-only hemlighet:
# får ALDRIG heta NEXT_PUBLIC_..., då hamnar den i webbläsaren. Skapas i
# Resend-dashboarden under API keys. I Cloudflare som Secret under Settings →
# Variables and Secrets (inte Build-sektionen: den behövs bara vid körning,
# inte vid bygget). Utan nyckel loggas förfrågningar men inga mejl skickas.
RESEND_API_KEY=

# Mottagaradress per företag för förfrågningar (lib/company-contacts.ts),
# INQUIRY_TO_<SLUG>. Står inte i koden eftersom repot är publikt. I Cloudflare
# som Secret under Settings → Variables and Secrets. Saknas adressen loggas
# förfrågan men inga mejl skickas för det företaget.
# (/kontakta-oss går alltid till info@localsafarifinder.com, se samma fil.)
INQUIRY_TO_HEC_KILIMANJARO_SAFARIS=
INQUIRY_TO_SMART_ESCAPES=
INQUIRY_TO_CARACAL_TOURS_SAFARIS=
INQUIRY_TO_SAFARI_JENS=
INQUIRY_TO_UTUKUFU_TRAVELS_ADVENTURES=

# Umami-statistik (app/layout.tsx). Website-ID:t finns i Umami-dashboarden
# (cloud.umami.is) under webbplatsens inställningar, fältet "Website ID".
# Inte hemligt (syns i sidans HTML). Utan värde laddas inget statistikskript.
# Sätts både lokalt (för utveckling, i .env.local) och i Cloudflares dashboard
# (redan gjort för produktion). Finns även under "vars" i wrangler.jsonc.
# Cloudflare: byggtid.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=b2fa7436-9eea-4de3-839d-9d0ab857be9b

# Kommande, används inte i koden än:
# Länk till den externa partnerportalen (/for-foretag). Cloudflare: byggtid.
# NEXT_PUBLIC_PARTNER_PORTAL_URL=
