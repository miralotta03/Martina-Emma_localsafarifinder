# Behövs normalt inte. Formulärens Worker (`npm run dev:api`, `npm run preview`)
# läser .env.local själv, men BARA om det inte finns någon .dev.vars. Lägg
# därför hemligheterna i .env.local (se .env.example) och ha ingen .dev.vars.
#
# Vill du ändå ha separata värden för Workern lokalt: kopiera den här filen
# till .dev.vars (ignoreras av git). Då läses .env.local inte alls, så alla
# variabler Workern behöver måste stå här.
RESEND_API_KEY=
INQUIRY_TO_HEC_KILIMANJARO_SAFARIS=
INQUIRY_TO_SMART_ESCAPES=
INQUIRY_TO_CARACAL_TOURS_SAFARIS=
INQUIRY_TO_SAFARI_JENS=
INQUIRY_TO_UTUKUFU_TRAVELS_ADVENTURES=
